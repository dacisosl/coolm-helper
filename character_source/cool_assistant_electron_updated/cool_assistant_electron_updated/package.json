{
  "name": "cool-assistant",
  "version": "0.2.0",
  "description": "투명 배경과 3/4 방향 기본 포즈가 적용된 펭귄 비서",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.coolassistant.desktop",
    "productName": "쿨 비서",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}